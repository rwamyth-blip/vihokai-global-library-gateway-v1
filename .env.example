# API Keys
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
DEEPSEEK_API_KEY=sk-...
KIMI_API_KEY=sk-...
NASA_API_KEY=DEMO_KEY

# Postgres
POSTGRES_DB=vihokai
POSTGRES_USER=vihokai
POSTGRES_PASSWORD=vihokai_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vihokai:vihokai_password@postgres:5432/vihokai

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=vihokai_docs

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# App
APP_ENV=development
LOG_LEVEL=INFO
