# API Keys
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-nano
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
KIMI_API_KEY=sk-...
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
NASA_API_KEY=DEMO_KEY

# Postgres
POSTGRES_DB=vihokai
POSTGRES_USER=vihokai
POSTGRES_PASSWORD=vihokai_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vihokai:vihokai_password@postgres:5432/vihokai

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=vihokai_docs

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# App
APP_ENV=development
LOG_LEVEL=INFO

# Frontend (docker build arg) — ตั้งเป็น domain ที่ browser เข้าถึง API ได้
# เช่น http://localhost:8000 (dev) หรือ https://api-gateway.vihokai.com (ผ่าน Cloudflare Tunnel)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare Tunnel (ทาง A: expose ไม่ต้อง forward port)
CLOUDFLARE_TUNNEL_TOKEN=
